{
  "_metadata": {
    "major_version": 2,
    "minor_version": 1
  },
  "display_information": {
    "name": "PyHookKit Sandbox",
    "description": "Synthetic Slack notification parity examples",
    "background_color": "#2C2D30"
  },
  "features": {
    "bot_user": {
      "display_name": "PyHookKit",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "files:write",
        "groups:history",
        "groups:read",
        "incoming-webhook",
        "chat:write",
        "reactions:write",
        "reactions:read",
        "usergroups:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://events.pyhookkit.example/slack/events",
      "bot_events": [
        "app_mention",
        "app_uninstalled",
        "message.channels",
        "message.groups",
        "reaction_added",
        "tokens_revoked"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://events.pyhookkit.example/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": true
  }
}
