---
import { Icon } from 'astro-icon/components';

export interface Props {
  icon?: string;
  title?: string;
  description?: string;
}

const {
  icon = 'tabler:info-square',
  title = await Astro.slots.render('title'),
  description = await Astro.slots.render('description'),
} = Astro.props;
---

<section class="border-y border-blue-100 bg-blue-50/90 dark:border-slate-700 dark:bg-slate-800 not-prose">
  <div class="mx-auto max-w-5xl px-4 py-5 sm:px-6 sm:py-6">
    <div class="flex items-start gap-3.5 sm:items-center sm:gap-4">
      <span
        class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-blue-100 text-blue-700 sm:mt-0 dark:bg-blue-950 dark:text-blue-300"
        aria-hidden="true"
      >
        <Icon name={icon} class="h-5 w-5" />
      </span>
      <div class="min-w-0 text-left">
        <strong class="block text-base leading-6 text-slate-900 dark:text-white" set:html={title} />
        <p
          class="mt-1 text-sm font-normal leading-6 text-slate-600 sm:text-base sm:leading-7 dark:text-slate-300"
          set:html={description}
        />
      </div>
    </div>
  </div>
</section>
