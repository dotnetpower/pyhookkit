{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pyhookkit.example/notification.schema.json",
  "title": "Canonical notification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "route",
    "body",
    "severity"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "route": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "severity": {
      "enum": [
        "info",
        "success",
        "warning",
        "error"
      ]
    },
    "facts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "links": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "mentions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/mention"
      }
    },
    "image": {
      "$ref": "#/$defs/image"
    },
    "threadKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sourceTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 75
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        }
      }
    },
    "mention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "alias"
      ],
      "properties": {
        "kind": {
          "enum": [
            "user",
            "group"
          ]
        },
        "alias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "altText"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "altText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  }
}
