{
  "openapi": "3.1.0",
  "info": {
    "title": "PyHookKit central notification router API",
    "version": "0.1.0",
    "description": "Authenticated canonical notification intake, target-specific submission, delivery status, health, and provider-native Webhook endpoints for the optional PyHookKit router.",
    "license": {
      "name": "MIT",
      "url": "https://github.com/dotnetpower/pyhookkit/blob/main/LICENSE"
    }
  },
  "externalDocs": {
    "description": "Central notification router guide",
    "url": "https://dotnetpower.github.io/pyhookkit/docs/central-notification-router/"
  },
  "servers": [
    {
      "url": "https://router.example.test",
      "description": "Synthetic deployment URL; replace it with the operator-owned router endpoint."
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Read router health",
        "operationId": "getRouterHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Router process is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status"],
                  "properties": { "status": { "const": "ok" } }
                }
              }
            }
          }
        }
      }
    },
    "/v1/notifications": {
      "post": {
        "summary": "Submit a canonical notification to every configured route target",
        "operationId": "submitNotification",
        "parameters": [{ "$ref": "#/components/parameters/Producer" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./contracts/notification.schema.json" }
            }
          }
        },
        "responses": {
          "202": { "$ref": "#/components/responses/SubmissionAccepted" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "413": { "$ref": "#/components/responses/Error" },
          "415": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/destinations/{targetId}/notifications": {
      "post": {
        "summary": "Submit a canonical notification to one configured target",
        "operationId": "submitNotificationToTarget",
        "parameters": [
          { "$ref": "#/components/parameters/Producer" },
          {
            "name": "targetId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./contracts/notification.schema.json" }
            }
          }
        },
        "responses": {
          "202": { "$ref": "#/components/responses/SubmissionAccepted" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "413": { "$ref": "#/components/responses/Error" },
          "415": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/notifications/{notificationId}": {
      "get": {
        "summary": "Read redacted aggregate and target delivery status",
        "operationId": "getNotificationStatus",
        "parameters": [
          { "$ref": "#/components/parameters/Producer" },
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Producer-owned notification status.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NotificationStatus" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/inbound/{provider}/{integrationId}": {
      "post": {
        "summary": "Receive an authenticated provider-native Webhook",
        "description": "Authentication headers and payload shape are provider-specific. Supported providers are GitHub, GitLab, and Azure DevOps.",
        "operationId": "receiveProviderWebhook",
        "security": [],
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "enum": ["github", "gitlab", "azure-devops"] }
          },
          {
            "name": "integrationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "type": "object" } }
          }
        },
        "responses": {
          "202": { "$ref": "#/components/responses/WebhookSubmissionAccepted" },
          "401": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "413": { "$ref": "#/components/responses/Error" },
          "415": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "producerBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Server-issued phk_ API key or configured legacy producer bearer credential."
      }
    },
    "parameters": {
      "Producer": {
        "name": "X-PyHookKit-Producer",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "schemas": {
      "SubmissionReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["notificationId", "duplicate", "state"],
        "properties": {
          "notificationId": { "type": "string", "format": "uuid" },
          "duplicate": { "type": "boolean" },
          "state": { "$ref": "#/components/schemas/NotificationState" },
          "targetId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      },
      "NotificationState": {
        "type": "string",
        "enum": ["queued", "delivering", "delivered", "partial_failed", "failed"]
      },
      "WebhookSubmissionReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": ["notificationId", "duplicate", "state", "integrationId"],
        "properties": {
          "notificationId": { "type": "string", "format": "uuid" },
          "duplicate": { "type": "boolean" },
          "state": { "$ref": "#/components/schemas/NotificationState" },
          "integrationId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "targetId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      },
      "TargetDeliveryState": {
        "type": "string",
        "enum": ["queued", "delivering", "succeeded", "failed"]
      },
      "NotificationStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": ["notificationId", "eventId", "state", "deliveries"],
        "properties": {
          "notificationId": { "type": "string", "format": "uuid" },
          "eventId": { "type": "string" },
          "state": { "$ref": "#/components/schemas/NotificationState" },
          "deliveries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["targetId", "state", "attempts"],
              "properties": {
                "targetId": { "type": "string" },
                "state": { "$ref": "#/components/schemas/TargetDeliveryState" },
                "attempts": { "type": "integer", "minimum": 0 },
                "errorKind": {
                  "type": "string",
                  "enum": [
                    "authentication",
                    "permission",
                    "rate_limited",
                    "invalid_payload",
                    "transient_provider",
                    "transport",
                    "permanent_provider"
                  ]
                },
                "statusCode": { "type": "integer", "minimum": 100, "maximum": 599 }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    },
    "responses": {
      "SubmissionAccepted": {
        "description": "Notification was committed to SQLite before the response was returned.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/SubmissionReceipt" }
          }
        }
      },
      "WebhookSubmissionAccepted": {
        "description": "Authenticated provider event was transformed and committed to SQLite.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/WebhookSubmissionReceipt" }
          }
        }
      },
      "Error": {
        "description": "Redacted request or authorization error.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    }
  },
  "security": [{ "producerBearer": [] }]
}
