---
import { Icon } from 'astro-icon/components';

interface Props {
  locale?: 'en' | 'ko';
}

const { locale = 'en' } = Astro.props;
const isKorean = locale === 'ko';
---

<div
  class="architecture"
  aria-label={isKorean
    ? '직접 Teams Webhook 전송과 선택적 자동화'
    : 'Direct Teams Webhook delivery and optional automation'}
>
  <div class="architecture-grid"></div>
  <div class="path-label">
    {isKorean ? '첫 알림에 필요한 직접 경로' : 'Direct path required for the first notification'}
  </div>
  <div class="delivery-path">
    <div class="node">
      <span class="node-icon producer"><Icon name="tabler:send" /></span>
      <span><strong>{isKorean ? '알림 요청' : 'Notification request'}</strong><small>HTTP + JSON</small></span>
    </div>
    <span class="arrow"><Icon name="tabler:arrow-right" /></span>
    <div class="node primary">
      <span class="node-icon flow"><Icon name="tabler:route-square-2" /></span>
      <span
        ><strong>Power Automate</strong><small
          >{isKorean ? '게시 계정의 Teams 연결' : 'Posting identity connection'}</small
        ></span
      >
    </div>
    <span class="arrow"><Icon name="tabler:arrow-right" /></span>
    <div class="node">
      <span class="node-icon teams"><Icon name="tabler:brand-microsoft-teams" /></span>
      <span><strong>Teams</strong><small>{isKorean ? '표준 채널' : 'Standard channel'}</small></span>
    </div>
  </div>

  <div class="optional-label">{isKorean ? '규모가 커진 후에만 선택' : 'Optional only after you scale'}</div>
  <div class="optional-tools">
    <div class="tool">
      <span class="node-icon graph"><Icon name="tabler:users-plus" /></span>
      <span
        ><strong>TeamsNotifyApp</strong><small
          >{isKorean ? 'Graph로 Team 멤버십 자동화' : 'Automates Team membership with Graph'}</small
        ></span
      >
      <span class="badge">{isKorean ? '메시지 게시 안 함' : 'Does not post'}</span>
    </div>
    <div class="tool">
      <span class="node-icon kit"><Icon name="tabler:route" /></span>
      <span
        ><strong>PyHookKit</strong><small
          >{isKorean ? 'Slack 전환 및 다중 대상 라우팅' : 'Slack migration and multi-target routing'}</small
        ></span
      >
      <span class="badge">{isKorean ? '직접 전송에 불필요' : 'Not required'}</span>
    </div>
  </div>
</div>

<style>
  .architecture {
    position: relative;
    display: flex;
    min-height: 26rem;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    overflow: hidden;
    padding: 2rem;
    border: 1px solid rgb(129 140 248 / 28%);
    border-radius: 1.5rem;
    background: linear-gradient(155deg, #17192a, #252b59 62%, #312e81);
    box-shadow: 0 28px 80px rgb(30 27 75 / 26%);
  }

  .architecture-grid {
    position: absolute;
    inset: 0;
    opacity: 0.13;
    background-image:
      linear-gradient(rgb(255 255 255 / 50%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 50%) 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: radial-gradient(circle, black, transparent 78%);
  }

  .path-label,
  .optional-label {
    position: relative;
    z-index: 1;
    color: #c7d2fe;
    font-size: 0.66rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
  }

  .optional-label {
    margin-top: 1.2rem;
    color: #bae6fd;
  }

  .delivery-path {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto 1.25fr auto 1fr;
    align-items: center;
    gap: 0.6rem;
  }

  .node,
  .tool {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: 0.9rem;
    background: rgb(255 255 255 / 8%);
    color: white;
    backdrop-filter: blur(12px);
  }

  .node.primary {
    border-color: rgb(216 180 254 / 42%);
    background: rgb(126 34 206 / 22%);
  }

  .node > span:last-child,
  .tool > span:nth-child(2) {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .node strong,
  .tool strong {
    font-size: 0.82rem;
  }

  .node small,
  .tool small {
    color: #bec7e7;
    font-size: 0.62rem;
  }

  .node-icon {
    display: grid;
    width: 2.3rem;
    height: 2.3rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 0.68rem;
    color: white;
  }

  .node-icon :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }

  .node-icon.producer {
    background: #0f766e;
  }
  .node-icon.flow {
    background: #9333ea;
  }
  .node-icon.teams {
    background: #6264a7;
  }
  .node-icon.graph {
    background: #0369a1;
  }
  .node-icon.kit {
    background: #4f46e5;
  }

  .arrow {
    color: #a5b4fc;
  }
  .arrow :global(svg) {
    width: 1.1rem;
  }

  .optional-tools {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
  }

  .tool {
    border-style: dashed;
    border-color: rgb(125 211 252 / 35%);
    background: rgb(14 116 144 / 10%);
  }

  .badge {
    margin-left: auto;
    padding: 0.3rem 0.45rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 10%);
    color: #bae6fd;
    font-size: 0.5rem;
    font-weight: 700;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .architecture {
      min-height: auto;
      padding: 1.25rem;
    }
    .delivery-path,
    .optional-tools {
      grid-template-columns: 1fr;
    }
    .arrow {
      justify-self: center;
      transform: rotate(90deg);
    }
    .badge {
      display: none;
    }
  }
</style>
