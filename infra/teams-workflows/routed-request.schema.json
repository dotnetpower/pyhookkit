{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pyhookkit.example/teams-workflow-request.schema.json",
  "title": "Routed Microsoft Teams Adaptive Card request",
  "type": "object",
  "required": [
    "type",
    "version",
    "body",
    "teamId",
    "channelId"
  ],
  "properties": {
    "$schema": {
      "const": "http://adaptivecards.io/schemas/adaptive-card.json"
    },
    "type": {
      "const": "AdaptiveCard"
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$"
    },
    "body": {
      "type": "array"
    },
    "actions": {
      "type": "array"
    },
    "msteams": {
      "type": "object"
    },
    "fallbackText": {
      "type": "string"
    },
    "teamId": {
      "type": "string",
      "format": "uuid"
    },
    "channelId": {
      "type": "string",
      "pattern": "^19:[A-Za-z0-9_-]+@thread\\.(?:tacv2|skype)$"
    }
  }
}
