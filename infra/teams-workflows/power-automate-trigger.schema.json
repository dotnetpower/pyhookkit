{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "channelLink",
    "teamId",
    "channelId",
    "attachments"
  ],
  "properties": {
    "type": {
      "const": "message"
    },
    "channelLink": {
      "type": "string",
      "maxLength": 2048
    },
    "teamId": {
      "type": "string",
      "format": "uuid"
    },
    "channelId": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contentType",
          "content"
        ],
        "properties": {
          "contentType": {
            "const": "application/vnd.microsoft.card.adaptive"
          },
          "contentUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "type": "object"
          }
        }
      }
    }
  }
}