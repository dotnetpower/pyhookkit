# Copy this file to .env and replace the blank values with local credentials.
# All credential values must remain blank in committed files.

# Slack Incoming Webhook URL for the test channel.
SLACK_WEBHOOK_URL=""

# Optional Slack Web API and inbound request values.
SLACK_BOT_TOKEN=""
SLACK_APP_TOKEN=""
SLACK_SIGNING_SECRET=""
SLACK_CHANNEL_ID=""
SLACK_TEST_DISPLAY_NAME=""
SLACK_USER_ID=""
SLACK_USER_GROUP_ID=""

# Microsoft Teams Workflow HTTP POST callback URL for the test channel.
TEAMS_WORKFLOW_URL=""
TEAMS_ASSET_BASE_URL=""
TEAMS_TEST_USER_ID=""
TEAMS_TEST_USER_NAME=""
