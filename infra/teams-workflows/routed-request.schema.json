{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pyhookkit.example/teams-workflow-request.schema.json",
  "title": "Routed Microsoft Teams Workflow request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "channelLink",
    "teamId",
    "channelId",
    "attachments"
  ],
  "properties": {
    "type": {
      "const": "message"
    },
    "channelLink": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://teams\\.microsoft\\.com/l/channel/",
      "maxLength": 2048
    },
    "teamId": {
      "type": "string",
      "format": "uuid"
    },
    "channelId": {
      "type": "string",
      "pattern": "^19:[A-Za-z0-9_-]+@thread\\.(?:tacv2|skype)$"
    },
    "attachments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contentType",
          "content"
        ],
        "properties": {
          "contentType": {
            "const": "application/vnd.microsoft.card.adaptive"
          },
          "contentUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "type": "object"
          }
        }
      }
    }
  }
}